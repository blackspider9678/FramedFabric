{
  "multipart": [
    { "when": { "has_camo": "false", "facing": "east",  "half": "bottom", "shape": "straight"     }, "apply": { "model": "framedfabric:block/framed_stairs" } },
    { "when": { "has_camo": "false", "facing": "west",  "half": "bottom", "shape": "straight"     }, "apply": { "model": "framedfabric:block/framed_stairs", "y": 180 } },
    { "when": { "has_camo": "false", "facing": "south", "half": "bottom", "shape": "straight"     }, "apply": { "model": "framedfabric:block/framed_stairs", "y": 90 } },
    { "when": { "has_camo": "false", "facing": "north", "half": "bottom", "shape": "straight"     }, "apply": { "model": "framedfabric:block/framed_stairs", "y": 270 } },

    { "when": { "has_camo": "false", "facing": "east",  "half": "top",    "shape": "straight"     }, "apply": { "model": "framedfabric:block/framed_stairs", "x": 180, "y": 180 } },
    { "when": { "has_camo": "false", "facing": "west",  "half": "top",    "shape": "straight"     }, "apply": { "model": "framedfabric:block/framed_stairs", "x": 180 } },
    { "when": { "has_camo": "false", "facing": "south", "half": "top",    "shape": "straight"     }, "apply": { "model": "framedfabric:block/framed_stairs", "x": 180, "y": 270 } },
    { "when": { "has_camo": "false", "facing": "north", "half": "top",    "shape": "straight"     }, "apply": { "model": "framedfabric:block/framed_stairs", "x": 180, "y": 90 } },

    { "when": { "has_camo": "false", "facing": "east",  "half": "bottom", "shape": "outer_right"  }, "apply": { "model": "framedfabric:block/framed_stairs_outer" } },
    { "when": { "has_camo": "false", "facing": "west",  "half": "bottom", "shape": "outer_right"  }, "apply": { "model": "framedfabric:block/framed_stairs_outer", "y": 180 } },
    { "when": { "has_camo": "false", "facing": "south", "half": "bottom", "shape": "outer_right"  }, "apply": { "model": "framedfabric:block/framed_stairs_outer", "y": 90 } },
    { "when": { "has_camo": "false", "facing": "north", "half": "bottom", "shape": "outer_right"  }, "apply": { "model": "framedfabric:block/framed_stairs_outer", "y": 270 } },

    { "when": { "has_camo": "false", "facing": "east",  "half": "bottom", "shape": "outer_left"   }, "apply": { "model": "framedfabric:block/framed_stairs_outer", "y": 270 } },
    { "when": { "has_camo": "false", "facing": "west",  "half": "bottom", "shape": "outer_left"   }, "apply": { "model": "framedfabric:block/framed_stairs_outer", "y": 90 } },
    { "when": { "has_camo": "false", "facing": "south", "half": "bottom", "shape": "outer_left"   }, "apply": { "model": "framedfabric:block/framed_stairs_outer" } },
    { "when": { "has_camo": "false", "facing": "north", "half": "bottom", "shape": "outer_left"   }, "apply": { "model": "framedfabric:block/framed_stairs_outer", "y": 180 } },

    { "when": { "has_camo": "false", "facing": "east",  "half": "top",    "shape": "outer_right"  }, "apply": { "model": "framedfabric:block/framed_stairs_outer", "x": 180, "y": 180 } },
    { "when": { "has_camo": "false", "facing": "west",  "half": "top",    "shape": "outer_right"  }, "apply": { "model": "framedfabric:block/framed_stairs_outer", "x": 180 } },
    { "when": { "has_camo": "false", "facing": "south", "half": "top",    "shape": "outer_right"  }, "apply": { "model": "framedfabric:block/framed_stairs_outer", "x": 180, "y": 270 } },
    { "when": { "has_camo": "false", "facing": "north", "half": "top",    "shape": "outer_right"  }, "apply": { "model": "framedfabric:block/framed_stairs_outer", "x": 180, "y": 90 } },

    { "when": { "has_camo": "false", "facing": "east",  "half": "top",    "shape": "outer_left"   }, "apply": { "model": "framedfabric:block/framed_stairs_outer", "x": 180, "y": 90 } },
    { "when": { "has_camo": "false", "facing": "west",  "half": "top",    "shape": "outer_left"   }, "apply": { "model": "framedfabric:block/framed_stairs_outer", "x": 180, "y": 270 } },
    { "when": { "has_camo": "false", "facing": "south", "half": "top",    "shape": "outer_left"   }, "apply": { "model": "framedfabric:block/framed_stairs_outer", "x": 180, "y": 180 } },
    { "when": { "has_camo": "false", "facing": "north", "half": "top",    "shape": "outer_left"   }, "apply": { "model": "framedfabric:block/framed_stairs_outer", "x": 180 } },

    { "when": { "has_camo": "false", "facing": "east",  "half": "bottom", "shape": "inner_right"  }, "apply": { "model": "framedfabric:block/framed_stairs_inner" } },
    { "when": { "has_camo": "false", "facing": "west",  "half": "bottom", "shape": "inner_right"  }, "apply": { "model": "framedfabric:block/framed_stairs_inner", "y": 180 } },
    { "when": { "has_camo": "false", "facing": "south", "half": "bottom", "shape": "inner_right"  }, "apply": { "model": "framedfabric:block/framed_stairs_inner", "y": 90 } },
    { "when": { "has_camo": "false", "facing": "north", "half": "bottom", "shape": "inner_right"  }, "apply": { "model": "framedfabric:block/framed_stairs_inner", "y": 270 } },

    { "when": { "has_camo": "false", "facing": "east",  "half": "bottom", "shape": "inner_left"   }, "apply": { "model": "framedfabric:block/framed_stairs_inner", "y": 270 } },
    { "when": { "has_camo": "false", "facing": "west",  "half": "bottom", "shape": "inner_left"   }, "apply": { "model": "framedfabric:block/framed_stairs_inner", "y": 90 } },
    { "when": { "has_camo": "false", "facing": "south", "half": "bottom", "shape": "inner_left"   }, "apply": { "model": "framedfabric:block/framed_stairs_inner" } },
    { "when": { "has_camo": "false", "facing": "north", "half": "bottom", "shape": "inner_left"   }, "apply": { "model": "framedfabric:block/framed_stairs_inner", "y": 180 } },

    { "when": { "has_camo": "false", "facing": "east",  "half": "top",    "shape": "inner_right"  }, "apply": { "model": "framedfabric:block/framed_stairs_inner", "x": 180, "y": 180 } },
    { "when": { "has_camo": "false", "facing": "west",  "half": "top",    "shape": "inner_right"  }, "apply": { "model": "framedfabric:block/framed_stairs_inner", "x": 180 } },
    { "when": { "has_camo": "false", "facing": "south", "half": "top",    "shape": "inner_right"  }, "apply": { "model": "framedfabric:block/framed_stairs_inner", "x": 180, "y": 270 } },
    { "when": { "has_camo": "false", "facing": "north", "half": "top",    "shape": "inner_right"  }, "apply": { "model": "framedfabric:block/framed_stairs_inner", "x": 180, "y": 90 } },

    { "when": { "has_camo": "false", "facing": "east",  "half": "top",    "shape": "inner_left"   }, "apply": { "model": "framedfabric:block/framed_stairs_inner", "x": 180, "y": 90 } },
    { "when": { "has_camo": "false", "facing": "west",  "half": "top",    "shape": "inner_left"   }, "apply": { "model": "framedfabric:block/framed_stairs_inner", "x": 180, "y": 270 } },
    { "when": { "has_camo": "false", "facing": "south", "half": "top",    "shape": "inner_left"   }, "apply": { "model": "framedfabric:block/framed_stairs_inner", "x": 180, "y": 180 } },
    { "when": { "has_camo": "false", "facing": "north", "half": "top",    "shape": "inner_left"   }, "apply": { "model": "framedfabric:block/framed_stairs_inner", "x": 180 } },

    { "when": { "has_camo": "true" }, "apply": { "model": "framedfabric:block/empty" } }
  ]
}
