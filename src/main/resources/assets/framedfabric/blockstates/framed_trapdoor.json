{
  "multipart": [
    {
      "when": { "open": false, "half": "bottom", "facing": "north" },
      "apply": { "model": "framedfabric:block/framed_trapdoor_bottom" }
    },
    {
      "when": { "open": false, "half": "bottom", "facing": "east" },
      "apply": { "model": "framedfabric:block/framed_trapdoor_bottom", "y": 90 }
    },
    {
      "when": { "open": false, "half": "bottom", "facing": "south" },
      "apply": { "model": "framedfabric:block/framed_trapdoor_bottom", "y": 180 }
    },
    {
      "when": { "open": false, "half": "bottom", "facing": "west" },
      "apply": { "model": "framedfabric:block/framed_trapdoor_bottom", "y": 270 }
    },

    {
      "when": { "open": false, "half": "top", "facing": "north" },
      "apply": { "model": "framedfabric:block/framed_trapdoor_top" }
    },
    {
      "when": { "open": false, "half": "top", "facing": "east" },
      "apply": { "model": "framedfabric:block/framed_trapdoor_top", "y": 90 }
    },
    {
      "when": { "open": false, "half": "top", "facing": "south" },
      "apply": { "model": "framedfabric:block/framed_trapdoor_top", "y": 180 }
    },
    {
      "when": { "open": false, "half": "top", "facing": "west" },
      "apply": { "model": "framedfabric:block/framed_trapdoor_top", "y": 270 }
    },

    {
      "when": { "open": true, "facing": "north" },
      "apply": { "model": "framedfabric:block/framed_trapdoor_open" }
    },
    {
      "when": { "open": true, "facing": "east" },
      "apply": { "model": "framedfabric:block/framed_trapdoor_open", "y": 90 }
    },
    {
      "when": { "open": true, "facing": "south" },
      "apply": { "model": "framedfabric:block/framed_trapdoor_open", "y": 180 }
    },
    {
      "when": { "open": true, "facing": "west" },
      "apply": { "model": "framedfabric:block/framed_trapdoor_open", "y": 270 }
    }
  ]
}
