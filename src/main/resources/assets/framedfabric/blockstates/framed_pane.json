{
  "multipart": [
    { "apply": { "model": "framedfabric:block/framed_pane_post" } },

    { "when": { "north": "true" }, "apply": { "model": "framedfabric:block/framed_pane_side", "uvlock": true } },
    { "when": { "east":  "true" }, "apply": { "model": "framedfabric:block/framed_pane_side", "y": 90,  "uvlock": true } },

    { "when": { "south": "true" }, "apply": { "model": "framedfabric:block/framed_pane_side_alt", "uvlock": true } },
    { "when": { "west":  "true" }, "apply": { "model": "framedfabric:block/framed_pane_side_alt", "y": 90,  "uvlock": true } },

    { "when": { "north": "false" }, "apply": { "model": "framedfabric:block/framed_pane_noside" } },
    { "when": { "east":  "false" }, "apply": { "model": "framedfabric:block/framed_pane_noside_alt" } },
    { "when": { "south": "false" }, "apply": { "model": "framedfabric:block/framed_pane_noside_alt", "y": 90 } },
    { "when": { "west":  "false" }, "apply": { "model": "framedfabric:block/framed_pane_noside", "y": 270 } }
  ]
}
