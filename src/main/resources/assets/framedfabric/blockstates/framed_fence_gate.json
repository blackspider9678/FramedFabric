{
  "multipart": [
    { "when": { "in_wall": "false", "open": "false", "facing": "north" }, "apply": { "model": "framedfabric:block/framed_fence_gate" } },
    { "when": { "in_wall": "false", "open": "false", "facing": "east"  }, "apply": { "model": "framedfabric:block/framed_fence_gate", "y": 90  } },
    { "when": { "in_wall": "false", "open": "false", "facing": "south" }, "apply": { "model": "framedfabric:block/framed_fence_gate", "y": 180 } },
    { "when": { "in_wall": "false", "open": "false", "facing": "west"  }, "apply": { "model": "framedfabric:block/framed_fence_gate", "y": 270 } },

    { "when": { "in_wall": "false", "open": "true",  "facing": "north" }, "apply": { "model": "framedfabric:block/framed_fence_gate_open" } },
    { "when": { "in_wall": "false", "open": "true",  "facing": "east"  }, "apply": { "model": "framedfabric:block/framed_fence_gate_open", "y": 90  } },
    { "when": { "in_wall": "false", "open": "true",  "facing": "south" }, "apply": { "model": "framedfabric:block/framed_fence_gate_open", "y": 180 } },
    { "when": { "in_wall": "false", "open": "true",  "facing": "west"  }, "apply": { "model": "framedfabric:block/framed_fence_gate_open", "y": 270 } },

    { "when": { "in_wall": "true",  "open": "false", "facing": "north" }, "apply": { "model": "framedfabric:block/framed_fence_gate_wall" } },
    { "when": { "in_wall": "true",  "open": "false", "facing": "east"  }, "apply": { "model": "framedfabric:block/framed_fence_gate_wall", "y": 90  } },
    { "when": { "in_wall": "true",  "open": "false", "facing": "south" }, "apply": { "model": "framedfabric:block/framed_fence_gate_wall", "y": 180 } },
    { "when": { "in_wall": "true",  "open": "false", "facing": "west"  }, "apply": { "model": "framedfabric:block/framed_fence_gate_wall", "y": 270 } },

    { "when": { "in_wall": "true",  "open": "true",  "facing": "north" }, "apply": { "model": "framedfabric:block/framed_fence_gate_wall_open" } },
    { "when": { "in_wall": "true",  "open": "true",  "facing": "east"  }, "apply": { "model": "framedfabric:block/framed_fence_gate_wall_open", "y": 90  } },
    { "when": { "in_wall": "true",  "open": "true",  "facing": "south" }, "apply": { "model": "framedfabric:block/framed_fence_gate_wall_open", "y": 180 } },
    { "when": { "in_wall": "true",  "open": "true",  "facing": "west"  }, "apply": { "model": "framedfabric:block/framed_fence_gate_wall_open", "y": 270 } }
  ]
}
