{
  "multipart": [
    { "when": { "corner": "se", "upside_down": "false" }, "apply": { "model": "framedfabric:block/framed_corner_post", "y": 0 } },
    { "when": { "corner": "sw", "upside_down": "false" }, "apply": { "model": "framedfabric:block/framed_corner_post", "y": 90 } },
    { "when": { "corner": "nw", "upside_down": "false" }, "apply": { "model": "framedfabric:block/framed_corner_post", "y": 180 } },
    { "when": { "corner": "ne", "upside_down": "false" }, "apply": { "model": "framedfabric:block/framed_corner_post", "y": 270 } },

    { "when": { "corner": "se", "upside_down": "true" }, "apply": { "model": "framedfabric:block/framed_corner_post", "x": 180, "y": 90 } },
    { "when": { "corner": "sw", "upside_down": "true" }, "apply": { "model": "framedfabric:block/framed_corner_post", "x": 180, "y": 180 } },
    { "when": { "corner": "nw", "upside_down": "true" }, "apply": { "model": "framedfabric:block/framed_corner_post", "x": 180, "y": 270 } },
    { "when": { "corner": "ne", "upside_down": "true" }, "apply": { "model": "framedfabric:block/framed_corner_post", "x": 180, "y": 0 } }
  ]
}
